@model List<RaceDay.MVC.Models.MyEnrollmentViewModel>

@{
    ViewData["Title"] = "My Enrollments";
    Layout = "_Layout";

    var confirmedCount = Model.Count(e => e.Status == "Confirmed");
    var totalCount = Model.Count;
}

    <style>
        * {
            box-sizing: border-box;
        }

        .page-container {
            margin: 0;
            background: linear-gradient(
                180deg, #eaf4ff 0%, #f8fbff 100%);
            color: #09275e;
            font-family: Arial, sans-serif;
            min-height: 100vh;
        }

        .page-container {
            max-width: 1260px;
            margin: 0 auto;
            padding: 42px 24px 70px;
        }

        .eyebrow {
            color: #0066ed;
            letter-spacing: 2px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .page-container h1, .page-container h2 {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            text-transform: uppercase;
        }

        .page-container h1 {
            font-size: 44px;
            margin: 0 0 8px;
            color: #082c79;
        }

        .subtitle {
            color: #637797;
            font-size: 15px;
            margin: 0;
        }

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 34px;
        }

        .primary-button {
            display: inline-block;
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            background: linear-gradient(100deg, #082e83, #079af5);
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            text-align: center;
        }

        .primary-button:hover {
            opacity: .9;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: white;
            border: 1px solid #d4e2f1;
            border-radius: 16px;
            padding: 21px;
            box-shadow: 0 3px 8px rgba(15,55,100,.05);
            min-height: 110px;
        }

        .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #536988;
            font-size: 14px;
        }

        .stat-icon {
            color: #006bfa;
            font-size: 22px;
        }

        .stat-value {
            color: #082c79;
            font-family: Impact, "Arial Narrow", sans-serif;
            font-size: 34px;
            margin-top: 12px;
        }

        .stat-note {
            font-size: 12px;
            color: #71809b;
            margin-top: 12px;
        }

        .stat-link {
            color: #006bfa;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
        }

        .empty-state {
            border: 1px dashed #d3e3f5;
            border-radius: 16px;
            padding: 56px 20px;
            text-align: center;
            background: rgba(255,255,255,.2);
        }

        .empty-icon {
            background: #dceeff;
            color: #0067e8;
            border-radius: 50%;
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            margin: 0 auto 18px;
            font-size: 25px;
        }

        .empty-state h2 {
            font-size: 22px;
            margin: 0 0 8px;
        }

        .empty-state p {
            color: #637797;
            font-size: 13px;
            margin-bottom: 22px;
        }

        .enrollment-list {
            display: grid;
            gap: 16px;
        }

        .enrollment-card {
            background: white;
            border: 1px solid #d7e4f1;
            border-radius: 15px;
            padding: 23px;
            box-shadow: 0 3px 10px rgba(10,50,100,.04);
        }

        .enrollment-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
        }

        .enrollment-title {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            text-transform: uppercase;
            font-size: 24px;
            margin: 0 0 8px;
        }

        .status {
            display: inline-block;
            border-radius: 20px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: bold;
            background: #e8f8ef;
            color: #16834f;
        }

        .status.other {
            background: #f0f3f7;
            color: #65748b;
        }

        .enrollment-details {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 17px;
        }

        .detail {
            background: #f1f6fc;
            padding: 10px 13px;
            border-radius: 9px;
            font-size: 13px;
            color: #536988;
        }

        .detail strong {
            color: #09275e;
        }

        .alert-danger {
            padding: 14px;
            background: #fff0f0;
            color: #b42318;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        @@media (max-width: 800px) {

            .page-container {
                padding: 28px 16px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .page-container h1 {
                font-size: 36px;
            }

.deregister-section {
    display: flex;
    justify-content: flex-end;
    margin-top: 20px;
}

.deregister-button {
    background: #fff0f0;
    color: #b42318;
    border: 1px solid #f4b4b4;
    border-radius: 9px;
    padding: 11px 18px;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
}

.deregister-button:hover {
    background: #ffe0e0;
}

        }
    </style>

<div class="page-container">

        <div class="page-heading">

            <div>
                <div class="eyebrow">PARTICIPANT</div>

                <h1>My Enrollments</h1>

                <p class="subtitle">
                    Every race you've signed up for, with your status and results.
                </p>
            </div>

            <a asp-controller="Participant"
               asp-action="Index"
               class="primary-button">
                Find more races
            </a>

        </div>

        @if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert-danger">
                @ViewBag.ErrorMessage
            </div>
        }

        <section class="stats-grid">

            <div class="stat-card">
                <div class="stat-top">
                    <span>Active enrollments</span>
                    <span class="stat-icon">☷</span>
                </div>

                <div class="stat-value">@confirmedCount</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Total enrollments</span>
                    <span class="stat-icon">▣</span>
                </div>

                <div class="stat-value">@totalCount</div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Results available</span>
                    <span class="stat-icon">♜</span>
                </div>

                <div class="stat-note">
                    View your finishing positions and times.
                </div>

                <p>
                    <a asp-controller="Participant"
                       asp-action="MyResults"
                       class="stat-link">
                        View Results
                    </a>
                </p>
            </div>

        </section>

        @if (Model.Count == 0)
        {
            <div class="empty-state">

                <div class="empty-icon">⚑</div>

                <h2>No Enrollments Yet</h2>

                <p>
                    Pick a race from Available Events and hit Enrol Now.
                </p>

                <a asp-controller="Participant"
                   asp-action="Index"
                   class="primary-button">
                    Browse events
                </a>

            </div>
        }
        else
        {
            <section class="enrollment-list">

                @foreach (var enrollment in Model)
                {
                    <article class="enrollment-card">

                        <div class="enrollment-header">

                            <div>
                                <h2 class="enrollment-title">
                                    @enrollment.EventName
                                </h2>

                                <p class="subtitle">
                                    @enrollment.CategoryName
                                </p>
                            </div>

                            <span class="status @(enrollment.Status == "Confirmed" ? "" : "other")">
                                @enrollment.Status
                            </span>

                        </div>

                        <div class="enrollment-details">

                            <div class="detail">
                                <strong>Entry Fee:</strong>
                                R @enrollment.EntryFee.ToString("0.00")
                            </div>

                            <div class="detail">
                                <strong>Registered:</strong>
                                @enrollment.EnrolledAt.ToString("dd MMM yyyy")
                            </div>

                        </div>


<div class="deregister-section">
    <form asp-controller="Participant"
          asp-action="Deregister"
          method="post"
          onsubmit="return confirm('Are you sure you want to deregister from this event?');">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="enrollmentId"
               value="@enrollment.EnrollmentsID" />

        <button type="submit" class="deregister-button">
            Deregister
        </button>
    </form>
</div>


                    </article>
                }

            </section>
        }


</div>
