
@model RaceDay.MVC.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>RaceDay | Change Password</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(180deg, #eaf4ff, #f8fbff);
            color: #09275e;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: rgba(255,255,255,.96);
            border-bottom: 1px solid #dce6f1;
            padding: 12px 0;
        }

        .nav-inner {
            max-width: 1260px;
            margin: auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
            color: #072d78;
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            font-size: 22px;
        }

        .brand-icon {
            background: linear-gradient(135deg, #063b99, #009bff);
            color: white;
            width: 37px;
            height: 37px;
            border-radius: 10px;
            display: grid;
            place-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 5px;
            flex: 1;
        }

        .nav-link {
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: #53647e;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #0067e8;
            background: #dceeff;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .role-badge {
            background: #dceeff;
            color: #0068e8;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: bold;
        }

        .profile-link {
            border: 1px solid #d5e1ee;
            background: white;
            border-radius: 50%;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #09275e;
            text-decoration: none;
        }

        .page-container {
            max-width: 1260px;
            margin: 0 auto;
            padding: 42px 24px 70px;
        }

        .eyebrow {
            color: #0066ed;
            letter-spacing: 2px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        h1 {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            font-size: 44px;
            text-transform: uppercase;
            color: #082c79;
            margin: 0 0 8px;
        }

        .subtitle {
            color: #637797;
            font-size: 15px;
            margin: 0 0 32px;
        }

        .profile-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .profile-tab {
            padding: 10px 15px;
            border-radius: 10px;
            color: #536988;
            text-decoration: none;
            font-size: 13px;
        }

        .profile-tab.active {
            background: white;
            color: #09275e;
            box-shadow: 0 2px 6px rgba(0,0,0,.08);
        }

        .password-card {
            background: white;
            border: 1px solid #d7e4f1;
            border-radius: 20px;
            padding: 32px;
            max-width: 450px;
            box-shadow: 0 5px 15px rgba(10,50,100,.05);
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 7px;
        }

        .form-control {
            width: 100%;
            height: 38px;
            border: 1px solid #cbdced;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 13px;
            color: #09275e;
            background: white;
            box-shadow: 0 2px 3px rgba(0,0,0,.05);
        }

        .form-control:focus {
            outline: 2px solid #8bc5ff;
        }

        .field-note {
            color: #71809b;
            font-size: 11px;
            margin-top: 8px;
        }

        .validation-error {
            color: #dc3545;
            font-size: 12px;
            display: block;
            margin-top: 5px;
        }

        .primary-button {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            background: linear-gradient(100deg, #082e83, #079af5);
            color: white;
            font-size: 13px;
            font-weight: bold;
            cursor: pointer;
        }

        .primary-button:hover {
            opacity: .92;
        }

        .alert {
            max-width: 450px;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .alert-success {
            background: #e5f8ee;
            color: #126e42;
        }

        .alert-danger {
            background: #fff0f0;
            color: #b42318;
        }

        @@media (max-width: 800px) {
            .nav-inner {
                flex-wrap: wrap;
            }

            .nav-links {
                order: 3;
                width: 100%;
                overflow-x: auto;
            }

            .page-container {
                padding: 28px 16px;
            }

            .password-card {
                padding: 22px;
            }

            h1 {
                font-size: 36px;
            }
        }
    </style>
</head>

<body>

    <header class="navbar">
        <div class="nav-inner">

            <a asp-controller="Participant"
               asp-action="Index"
               class="brand">
                <span class="brand-icon">⚑</span>
                RACE<span style="color:#008fff">DAY</span>
            </a>

            <nav class="nav-links">

                <a asp-action="Index"
                   class="nav-link">
                    Available Events
                </a>

                <a asp-action="MyEnrollments"
                   class="nav-link">
                    My Enrollments
                </a>

                <a asp-action="MyProfile"
                   class="nav-link active">
                    My Profile
                </a>

            </nav>

            <div class="nav-right">
                <span class="role-badge">PARTICIPANT</span>

                <a asp-action="MyProfile"
                   class="profile-link"
                   title="My Profile">
                    ♙
                </a>
            </div>

        </div>
    </header>

    <main class="page-container">

        <div class="eyebrow">ACCOUNT</div>

        <h1>My Profile</h1>

        <p class="subtitle">
            Update your personal details and password.
        </p>

        <div class="profile-tabs">

            <a asp-action="MyProfile"
               class="profile-tab">
                ♙ Personal information
            </a>

            <a asp-action="ChangePassword"
               class="profile-tab active">
                ⚿ Change password
            </a>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="password-card">

            <form asp-controller="Participant"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-error"></div>

                <div class="form-group">

                    <label asp-for="CurrentPassword">
                        Current password
                    </label>

                    <input asp-for="CurrentPassword"
                           type="password"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="CurrentPassword"
                          class="validation-error"></span>

                </div>

                <div class="form-group">

                    <label asp-for="NewPassword">
                        New password
                    </label>

                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <div class="field-note">
                        At least 8 characters.
                    </div>

                    <span asp-validation-for="NewPassword"
                          class="validation-error"></span>

                </div>

                <div class="form-group">

                    <label asp-for="ConfirmNewPassword">
                        Confirm new password
                    </label>

                    <input asp-for="ConfirmNewPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmNewPassword"
                          class="validation-error"></span>

                </div>

                <button type="submit"
                        class="primary-button">
                    Update password
                </button>

            </form>

        </div>

    </main>

</body>
</html>
