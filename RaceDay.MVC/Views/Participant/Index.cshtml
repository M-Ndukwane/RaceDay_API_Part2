@model RaceDay.MVC.Models.ParticipantDashboardViewModel

@{
    ViewData["Title"] = "Available Events";
    Layout = "_Layout";
}

<style>
        * {
            box-sizing: border-box;
        }



        .navbar {
            background: rgba(255,255,255,.96);
            border-bottom: 1px solid #dce6f1;
            padding: 14px 0;
        }

        .nav-inner {
            max-width: 1260px;
            margin: auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
            color: #072d78;
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            font-size: 22px;
        }

        .brand-icon {
            background: linear-gradient(135deg, #063b99, #009bff);
            color: white;
            width: 37px;
            height: 37px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-family: Arial, sans-serif;
            font-style: normal;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 5px;
            flex: 1;
        }

        .nav-link {
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: #53647e;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #0067e8;
            background: #dceeff;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .role-badge {
            background: #dceeff;
            color: #0068e8;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: bold;
        }

        .profile-link {
            border: 1px solid #d5e1ee;
            background: white;
            border-radius: 50%;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #09275e;
            text-decoration: none;
        }

        .page-container {
            max-width: 1260px;
            margin: 0 auto;
            padding: 42px 24px 70px;
        }

        .eyebrow {
            color: #0066ed;
            letter-spacing: 2px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        h1, h2, h3 {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            text-transform: uppercase;
        }

        h1 {
            font-size: 44px;
            margin: 0 0 8px;
            color: #082c79;
        }

        .subtitle {
            color: #637797;
            margin: 0 0 32px;
            font-size: 15px;
        }

        .filters {
            display: grid;
            grid-template-columns: 1fr 225px;
            gap: 12px;
            margin-bottom: 24px;
        }

        .filter-input {
            width: 100%;
            height: 40px;
            background: #f1f7ff;
            border: 1px solid #cbdced;
            border-radius: 11px;
            padding: 0 14px;
            font-size: 13px;
            color: #09275e;
            box-shadow: 0 2px 3px rgba(0,0,0,.05);
        }

        .filter-input:focus {
            outline: 2px solid #8bc5ff;
        }

        .event-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 22px;
        }

        .event-card {
            background: white;
            border: 1px solid #dce7f3;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(10,50,100,.05);
        }

        .event-card-header {
            padding: 22px 22px 15px;
            background: linear-gradient(120deg, #e2f0ff, #f9fcff);
        }

        .event-card h2 {
            font-size: 25px;
            margin: 0 0 8px;
        }

        .event-description {
            font-size: 14px;
            line-height: 1.6;
            color: #637797;
        }

        .event-body {
            padding: 20px 22px;
        }

        .event-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 18px;
        }

        .meta-pill {
            background: #f1f6fc;
            padding: 8px 10px;
            border-radius: 8px;
            font-size: 12px;
        }

        .status {
            display: inline-block;
            border-radius: 20px;
            padding: 5px 10px;
            font-size: 12px;
            font-weight: bold;
            background: #e5f8ee;
            color: #14844d;
        }

        .status.closed {
            background: #f2f3f6;
            color: #6b7280;
        }

        .category-card {
            border: 1px solid #dce7f3;
            border-radius: 12px;
            padding: 16px;
            margin-top: 12px;
            background: #fbfdff;
        }

        .category-card h3 {
            font-size: 19px;
            margin: 0 0 12px;
        }

        .category-meta {
            color: #637797;
            font-size: 13px;
            margin: 7px 0;
        }

        .field-label {
            display: block;
            font-size: 12px;
            font-weight: bold;
            margin: 12px 0 6px;
        }

        .field-input {
            width: 100%;
            border: 1px solid #cbdced;
            border-radius: 8px;
            padding: 11px;
            font-size: 13px;
        }

        .primary-button {
            display: inline-block;
            border: none;
            border-radius: 9px;
            padding: 12px 17px;
            background: linear-gradient(100deg, #082e83, #079af5);
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            text-align: center;
        }

        .primary-button:hover {
            opacity: .9;
        }

        .full-width {
            width: 100%;
            margin-top: 14px;
        }

        .disabled-button {
            background: #e5e9ef;
            color: #667085;
            border: none;
            padding: 11px;
            border-radius: 9px;
            width: 100%;
        }

        .empty-state {
            border: 1px dashed #d3e3f5;
            border-radius: 16px;
            padding: 56px 20px;
            text-align: center;
            background: rgba(255,255,255,.2);
        }

        .empty-icon {
            background: #dceeff;
            color: #0067e8;
            border-radius: 50%;
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            margin: 0 auto 18px;
            font-size: 25px;
        }

        .empty-state h2 {
            font-size: 22px;
            margin: 0 0 8px;
        }

        .empty-state p {
            color: #637797;
            font-size: 13px;
        }

        .quick-links {
            margin-top: 36px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .quick-card {
            background: white;
            border: 1px solid #dce7f3;
            border-radius: 14px;
            padding: 22px;
        }

        .quick-card h3 {
            font-size: 21px;
            margin: 0 0 8px;
        }

        .quick-card p {
            font-size: 13px;
            color: #637797;
            line-height: 1.5;
        }

        .alert {
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: #e5f8ee;
            color: #126e42;
        }

        .alert-danger {
            background: #fff0f0;
            color: #b42318;
        }

        @@media (max-width: 800px) {
            .nav-inner {
                flex-wrap: wrap;
                gap: 12px;
            }

            .nav-links {
                order: 3;
                width: 100%;
                overflow-x: auto;
            }

            .page-container {
                padding: 28px 16px;
            }

            .filters,
            .event-grid,
            .quick-links {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 36px;
            }
        }
</style>

<main class="page-container">

        <div class="eyebrow">PARTICIPANT</div>

        <h1>Available Events</h1>

        <p class="subtitle">
            Open races you can join. Hit Enrol Now to grab your spot.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="filters">
            <input type="search"
                   id="eventSearch"
                   class="filter-input"
                   placeholder="⌕  Search by race or description" />

            <select id="categoryFilter"
                    class="filter-input">
                <option value="">All categories</option>

                @foreach (var category in Model.Categories
                    .GroupBy(c => c.CategoryName)
                    .Select(g => g.First()))
                {
                    <option value="@category.CategoryName">
                        @category.CategoryName
                    </option>
                }
            </select>
        </div>

        @if (Model.Events.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">▣</div>

                <h2>No races open right now</h2>

                <p>
                    Check back soon — organizers add new events regularly.
                </p>
            </div>
        }
        else
        {
            <div class="event-grid" id="eventGrid">

                @foreach (var raceEvent in Model.Events)
                {
                    var eventCategories = Model.Categories
                        .Where(c => c.EventsID == raceEvent.EventsID)
                        .ToList();

                    <article class="event-card"
                             data-search="@($"{raceEvent.EventName} {raceEvent.Description}".ToLowerInvariant())"
                             data-categories="@string.Join("|", eventCategories.Select(c => c.CategoryName.ToLowerInvariant()))">

                        <div class="event-card-header">
                            <h2>@raceEvent.EventName</h2>

                            <span class="status @(raceEvent.Status == "Open" ? "" : "closed")">
                                @raceEvent.Status
                            </span>

                            <p class="event-description">
                                @raceEvent.Description
                            </p>
                        </div>

                        <div class="event-body">

                            <div class="event-meta">
                                <span class="meta-pill">
                                    📅 @raceEvent.EventDate.ToString("dd MMM yyyy")
                                </span>

                                <span class="meta-pill">
                                    🕒 @raceEvent.StartTime
                                </span>
                            </div>

                            <h3>Available Categories</h3>

                            @if (eventCategories.Count == 0)
                            {
                                <p class="event-description">
                                    No categories available.
                                </p>
                            }
                            else
                            {
                                @foreach (var category in eventCategories)
                                {
                                    <div class="category-card">

                                        <h3>@category.CategoryName</h3>

                                        <p class="category-meta">
                                            Entry Fee:
                                            <strong>
                                                R @category.EntryFee.ToString("0.00")
                                            </strong>
                                        </p>

                                        <p class="category-meta">
                                            Maximum Participants:
                                            @category.MaxParticipants
                                        </p>

                                        @if (raceEvent.Status == "Open")
                                        {
                                            <form asp-controller="Participant"
                                                  asp-action="Enroll"
                                                  method="post">

                                                <input type="hidden"
                                                       name="EventsID"
                                                       value="@raceEvent.EventsID" />

                                                <input type="hidden"
                                                       name="CategoriesID"
                                                       value="@category.CategoriesID" />

                                                <label class="field-label">
                                                    Emergency Contact Name
                                                </label>

                                                <input type="text"
                                                       name="EmergencyContactName"
                                                       class="field-input"
                                                       placeholder="Contact name" />

                                                <label class="field-label">
                                                    Emergency Contact Phone
                                                </label>

                                                <input type="text"
                                                       name="EmergencyContactPhone"
                                                       class="field-input"
                                                       placeholder="Contact number" />

                                                <button type="submit"
                                                        class="primary-button full-width">
                                                    Enrol Now
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button class="disabled-button"
                                                    disabled>
                                                Registration Closed
                                            </button>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </article>
                }

            </div>

            <div class="empty-state"
                 id="noSearchResults"
                 style="display:none; margin-top:20px;">
                <div class="empty-icon">⌕</div>
                <h2>No matching races</h2>
                <p>Try another search or category.</p>
            </div>
        }



</main>

<script>
        const searchInput = document.getElementById("eventSearch");
        const categoryFilter = document.getElementById("categoryFilter");

        function filterEvents() {
            const query = searchInput.value.trim().toLowerCase();
            const category = categoryFilter.value.toLowerCase();

            const cards = document.querySelectorAll(".event-card");
            let visibleCount = 0;

            cards.forEach(card => {
                const matchesSearch =
                    card.dataset.search.includes(query);

                const categories =
                    card.dataset.categories.split("|");

                const matchesCategory =
                    !category || categories.includes(category);

                const visible = matchesSearch && matchesCategory;

                card.style.display = visible ? "" : "none";

                if (visible) visibleCount++;
            });

            const emptyMessage =
                document.getElementById("noSearchResults");

            if (emptyMessage) {
                emptyMessage.style.display =
                    cards.length > 0 && visibleCount === 0
                        ? "block"
                        : "none";
            }
        }

        if (searchInput && categoryFilter) {
            searchInput.addEventListener("input", filterEvents);
            categoryFilter.addEventListener("change", filterEvents);
        }
</script>
