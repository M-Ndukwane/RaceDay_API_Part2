
@model RaceDay.MVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RaceDay | Create Account</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            color: #102d60;
        }

        .register-page {
            display: grid;
            grid-template-columns: 1fr 1fr;
            min-height: 100vh;
        }

        .register-image {
            background:
                linear-gradient(rgba(0, 42, 130, .12),
                                rgba(0, 42, 130, .12)),
                url('/images/raceday-login-panel.png')
                center center / cover no-repeat;
            min-height: 100vh;
        }

        .register-right {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 45px 30px;
            background: white;
        }

        .register-form {
            width: 100%;
            max-width: 448px;
        }

        .register-title {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-size: 30px;
            font-style: italic;
            color: #092e70;
            margin: 0 0 5px;
            text-transform: uppercase;
        }

        .register-subtitle {
            color: #71809b;
            font-size: 14px;
            margin-bottom: 24px;
        }

        .tabs {
            display: flex;
            background: #f0f5fc;
            padding: 4px;
            border-radius: 12px;
            margin-bottom: 25px;
        }

        .tab {
            width: 50%;
            text-align: center;
            padding: 11px;
            text-decoration: none;
            color: #17365f;
            font-size: 13px;
            border-radius: 9px;
        }

        .tab.active {
            background: white;
            color: #006dff;
            font-weight: bold;
            box-shadow: 0 2px 6px rgba(0,0,0,.06);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .form-control {
            width: 100%;
            height: 42px;
            border: 1px solid #d1ddeb;
            border-radius: 10px;
            padding: 10px 13px;
            font-size: 14px;
            outline: none;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }

        .form-control:focus {
            border-color: #0786f5;
            box-shadow: 0 0 0 3px rgba(0,120,255,.1);
        }

        .role-options {
            display: flex;
            gap: 12px;
        }

        .role-option {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            border: 2px solid #d8e2ee;
            border-radius: 12px;
            padding: 13px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
        }

        .role-option:has(input:checked) {
            border-color: #006dff;
            background: #d9edff;
            color: #006dff;
        }

        .role-option input {
            accent-color: #006dff;
        }

        .validation-error,
        .validation-summary {
            color: #dc3545;
            font-size: 12px;
        }

        .validation-summary {
            margin-bottom: 12px;
        }

        .register-button {
            width: 100%;
            height: 44px;
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            margin-top: 10px;
            background: linear-gradient(100deg, #082c80, #0799f5);
        }

        .register-button:hover {
            opacity: .92;
        }

        .back-login {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #006dff;
            font-size: 13px;
            text-decoration: none;
            font-weight: 600;
        }

        @@media (max-width: 800px) {
            .register-page {
                grid-template-columns: 1fr;
            }

            .register-image {
                display: none;
            }

            .register-right {
                min-height: 100vh;
            }
        }
    </style>
</head>

<body>
    <div class="register-page">

        <div class="register-image"></div>

        <div class="register-right">
            <div class="register-form">

                <h1 class="register-title">Create Account</h1>

                <p class="register-subtitle">
                    Join as a runner or an organizer.
                </p>

                <div class="tabs">
                    <a class="tab"
                       asp-controller="Account"
                       asp-action="Login">
                        Sign in
                    </a>

                    <a class="tab active"
                       asp-controller="Account"
                       asp-action="Register">
                        Sign up
                    </a>
                </div>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"></div>

                    <div class="form-group">
                        <label>I'm signing up as</label>

                        <div class="role-options">

                            <label class="role-option">
                                <input asp-for="Role"
                                       type="radio"
                                       value="Participant"
                                       checked />
                                <span>🏅 Participant</span>
                            </label>

                            <label class="role-option">
                                <input asp-for="Role"
                                       type="radio"
                                       value="Organiser" />
                                <span>♧ Organiser</span>
                            </label>

                        </div>

                        <span asp-validation-for="Role"
                              class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="FirstName">First Name</label>
                        <input asp-for="FirstName"
                               class="form-control" />
                        <span asp-validation-for="FirstName"
                              class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName">Last Name</label>
                        <input asp-for="LastName"
                               class="form-control" />
                        <span asp-validation-for="LastName"
                              class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control" />
                        <span asp-validation-for="Email"
                              class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <input asp-for="PhoneNumber"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control" />
                        <span asp-validation-for="Password"
                              class="validation-error"></span>
                    </div>

                    <button type="submit" class="register-button">
                        Create account
                    </button>

                </form>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="back-login">
                    ← Back to sign in
                </a>

            </div>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
