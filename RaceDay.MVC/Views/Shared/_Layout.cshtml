
@{
    var role = Context.Session.GetString("Role");
    var isOrganiser = role == "Organiser";
    var isParticipant = role == "Participant";
    var isLoggedIn = isOrganiser || isParticipant;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDay.MVC.styles.css"
          asp-append-version="true" />

    <style>
        body {
            background: #f0f6ff;
            color: #102447;
            margin: 0;
        }

        .raceday-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e0e9f4;
            padding: 10px 0;
        }

        .raceday-nav-container {
            max-width: 1250px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .raceday-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            white-space: nowrap;
        }

        .raceday-logo {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #064caa, #0589ef);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 22px;
            font-weight: 900;
        }

        .raceday-brand-text {
            font-size: 22px;
            font-weight: 900;
            font-style: italic;
            color: #092b76;
            letter-spacing: -1px;
        }

        .raceday-brand-text span {
            color: #0589ef;
        }

        .raceday-nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .raceday-nav-link {
            color: #203b64;
            text-decoration: none;
            padding: 11px 13px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 650;
            white-space: nowrap;
        }

        .raceday-nav-link:hover {
            background: #eaf4ff;
            color: #1265b9;
        }

        .raceday-nav-link.active {
            background: #e4f1ff;
            color: #1265b9;
            font-weight: 800;
        }

        .raceday-nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .raceday-role {
            padding: 9px 15px;
            border-radius: 25px;
            background: #e4f1ff;
            color: #1265b9;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .raceday-logout {
            border: 1px solid #dce5f0;
            background: #ffffff;
            color: #203b64;
            padding: 9px 13px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }

        .raceday-logout:hover {
            background: #eaf4ff;
            color: #1265b9;
        }

        .raceday-main {
            min-height: calc(100vh - 100px);
        }

        @@media (max-width: 950px) {
            .raceday-nav-container {
                flex-wrap: wrap;
                justify-content: center;
            }

            .raceday-nav-links {
                justify-content: center;
            }
        }

        @@media (max-width: 600px) {
            .raceday-nav-container {
                padding: 10px 15px;
            }

            .raceday-nav-link {
                padding: 8px 10px;
                font-size: 12px;
            }

            .raceday-brand-text {
                font-size: 19px;
            }
        }
    </style>
</head>

<body>

    <header class="raceday-navbar">

        <nav class="raceday-nav-container"
             aria-label="Main navigation">

           <a asp-controller="@(isParticipant ? "Participant" : isOrganiser ? "Organiser" : "Account")"
   asp-action="@(isOrganiser ? "ManageEvents" : isParticipant ? "Index" : "Login")"
   class="raceday-brand">

                <span class="raceday-logo">
                    ⚑
                </span>

                <span class="raceday-brand-text">
                    RACE <span>DAY</span>
                </span>

            </a>

            @if (isOrganiser)
            {
                <div class="raceday-nav-links">

          <a asp-controller="Organiser"
            asp-action="ManageEvents"
            class="raceday-nav-link">
            Events
          </a>

                    <a asp-controller="Organiser"
                       asp-action="ManageCategories"
                       class="raceday-nav-link">
                        Categories
                    </a>


                    <a asp-controller="Organiser"
                       asp-action="ManageVenues"
                       class="raceday-nav-link">
                        Venues
                    </a>

                    <a asp-controller="Organiser"
                       asp-action="ManageResults"
                       class="raceday-nav-link">
                        Results
                    </a>

                    <a asp-controller="Organiser"
                       asp-action="ManageEnrollments"
                       class="raceday-nav-link">
                        Enrollments
                    </a>

                    <a asp-controller="Organiser"
                       asp-action="MyProfile"
                       class="nav-link"
                       style="font-weight: 600;">
                       My Profile
                    </a>

                </div>

                <div class="raceday-nav-right">

                    <span class="raceday-role">
                        ORGANIZER
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="raceday-logout">
                            Logout
                        </button>

                    </form>

                </div>
            }

else if (isParticipant)
{
    <div class="raceday-nav-links">

        <a asp-controller="Participant"
           asp-action="Index"
           class="raceday-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            Available Events
        </a>

        <a asp-controller="Participant"
           asp-action="MyEnrollments"
           class="raceday-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyEnrollments" ? "active" : "")">
            My Enrollments
        </a>

        <a asp-controller="Participant"
           asp-action="MyProfile"
           class="raceday-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyProfile" ? "active" : "")">
            My Profile
        </a>

        <a asp-controller="Participant"
           asp-action="MyResults"
           class="raceday-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyResults" ? "active" : "")">
            My Results
        </a>

    </div>

    <div class="raceday-nav-right">

        <span class="raceday-role">
            PARTICIPANT
        </span>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">

            <button type="submit"
                    class="raceday-logout">
                Logout
            </button>

        </form>

    </div>
}

            else
            {
                <div class="raceday-nav-links">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="raceday-nav-link">
                        Login
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="raceday-nav-link">
                        Register
                    </a>

                </div>
            }

        </nav>

    </header>

    <main role="main" class="raceday-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
