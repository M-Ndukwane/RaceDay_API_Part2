
@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
    Layout = "_Layout";

    var events = Model ?? new List<RaceDay.MVC.Models.EventViewModel>();

    int totalEvents = events.Count;
    int upcomingEvents = events.Count(e =>
        e.EventDate.Date >= DateTime.Today);
}

<style>
    .events-page {
        max-width: 1230px;
        margin: 40px auto;
        padding: 0 20px 60px;
        color: #09275e;
        font-family: Arial, sans-serif;
    }

    .events-page * {
        box-sizing: border-box;
    }

    .events-page .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 32px;
    }

    .events-page .eyebrow {
        color: #0066ed;
        letter-spacing: 2px;
        font-size: 12px;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .events-page h1 {
        font-family: Impact, "Arial Narrow", sans-serif;
        font-style: italic;
        font-size: 44px;
        text-transform: uppercase;
        color: #082c79;
        margin: 0 0 8px;
    }

    .events-page .subtitle {
        color: #637797;
        font-size: 15px;
        margin: 0;
    }

    .events-page .primary-button {
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        background: linear-gradient(100deg, #082e83, #079af5);
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: bold;
        display: inline-block;
    }

    .events-page .primary-button:hover {
        opacity: .9;
        color: white;
    }

    .events-page .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .events-page .stat-card {
        background: white;
        border: 1px solid #d7e4f1;
        border-radius: 16px;
        padding: 22px 20px;
        box-shadow: 0 3px 7px rgba(10,50,100,.05);
    }

    .events-page .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #536988;
        font-size: 13px;
    }

    .events-page .stat-icon {
        color: #0067e8;
        font-size: 21px;
    }

    .events-page .stat-number {
        font-family: Impact, "Arial Narrow", sans-serif;
        font-size: 32px;
        color: #082c79;
        margin-top: 12px;
    }

    .events-page .events-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .events-page .event-card {
        background: white;
        border: 1px solid #d7e4f1;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 3px 7px rgba(10,50,100,.05);
    }

    .events-page .event-title {
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 12px;
        color: #09275e;
    }

    .events-page .event-description {
        color: #637797;
        font-size: 13px;
        line-height: 1.6;
        min-height: 42px;
    }

    .events-page .event-info {
        color: #536988;
        font-size: 13px;
        margin-top: 12px;
    }

    .events-page .event-status {
        display: inline-block;
        margin-top: 15px;
        background: #dceeff;
        color: #0067e8;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: bold;
    }

    .events-page .event-status.closed {
        background: #f1f3f6;
        color: #64748b;
    }

    .events-page .event-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .events-page .secondary-button {
        display: inline-block;
        padding: 10px 14px;
        border-radius: 9px;
        background: #edf5ff;
        color: #0067e8;
        font-size: 12px;
        font-weight: bold;
        text-decoration: none;
    }

    .events-page .secondary-button:hover {
        background: #dceeff;
        color: #0054b8;
    }

    .events-page .delete-button {
        background: #fff0ef;
        color: #c53636;
    }

    .events-page .delete-button:hover {
        background: #ffe0de;
        color: #b42323;
    }

    .events-page .empty-state {
        border: 1px dashed #cbdff5;
        border-radius: 18px;
        background: rgba(240,247,255,.65);
        padding: 58px 24px;
        text-align: center;
    }

    .events-page .empty-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #dceeff;
        color: #0067e8;
        display: grid;
        place-items: center;
        margin: 0 auto 18px;
        font-size: 26px;
    }

    .events-page .empty-title {
        font-family: Impact, "Arial Narrow", sans-serif;
        font-size: 23px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .events-page .empty-description {
        color: #637797;
        font-size: 13px;
        margin-bottom: 22px;
    }

    .events-page .message {
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .events-page .message-error {
        background: #fff0f0;
        color: #b42318;
    }

    .events-page .message-success {
        background: #e7f7ee;
        color: #16824a;
    }

    @@media (max-width: 900px) {
        .events-page .stats-grid,
        .events-page .events-grid {
            grid-template-columns: 1fr;
        }

        .events-page .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .events-page h1 {
            font-size: 36px;
        }
    }
</style>

<div class="events-page">

    <div class="page-header">
        <div>
            <div class="eyebrow">ORGANIZER</div>

            <h1>Manage Events</h1>

            <p class="subtitle">
                Create, edit and manage your race events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="primary-button">
            ⚑ New event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="message message-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="message message-error">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="message message-error">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-top">
                <span>Events</span>
                <span class="stat-icon">⚑</span>
            </div>

            <div class="stat-number">
                @totalEvents
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span>Upcoming</span>
                <span class="stat-icon">▦</span>
            </div>

            <div class="stat-number">
                @upcomingEvents
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-top">
                <span>Total enrolled</span>
                <span class="stat-icon">♙</span>
            </div>

            <div class="stat-number">
                @(ViewBag.TotalEnrolled != null
                    ? ViewBag.TotalEnrolled.ToString()
                    : "—")
            </div>
        </div>

    </div>

    @if (events.Any())
    {
        <div class="events-grid">

            @foreach (var raceEvent in events)
            {
                <div class="event-card">

                    <div class="event-title">
                        @raceEvent.EventName
                    </div>

                    <div class="event-description">
                        @(string.IsNullOrWhiteSpace(raceEvent.Description)
                            ? "No description available."
                            : raceEvent.Description)
                    </div>

                    <div class="event-info">
                        📅 @raceEvent.EventDate.ToString("dd MMM yyyy")
                    </div>

                    <div class="event-info">
                        🕒 @raceEvent.StartTime.ToString(@"hh\:mm")
                    </div>

                    <div class="event-status @(raceEvent.Status == "Open" ? "" : "closed")">
                        @raceEvent.Status
                    </div>

                    <div class="event-actions">

                        <a asp-controller="Organiser"
                           asp-action="EditEvent"
                           asp-route-id="@raceEvent.EventsID"
                           class="secondary-button">
                            Edit event
                        </a>

                        <a asp-controller="Organiser"
                           asp-action="DeleteEvent"
                           asp-route-id="@raceEvent.EventsID"
                           class="secondary-button delete-button">
                            Delete event
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else if (ViewBag.ErrorMessage == null)
    {
        <div class="empty-state">

            <div class="empty-icon">⚑</div>

            <div class="empty-title">
                No Events Yet
            </div>

            <div class="empty-description">
                Create your first race so participants can start enrolling.
            </div>

            <a asp-controller="Organiser"
               asp-action="CreateEvent"
               class="primary-button">
                ⚑ Create event
            </a>

        </div>
    }

</div>
