
@model RaceDay.MVC.Models.ManageCategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<style>
    .edit-category-page {
        max-width: 980px;
        margin: 45px auto;
        padding: 0 24px 60px;
        color: #102447;
    }

    .edit-category-eyebrow {
        color: #1265b9;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 8px;
    }

    .edit-category-title {
        font-size: 34px;
        font-weight: 900;
        font-style: italic;
        text-transform: uppercase;
        color: #0b2453;
        margin-bottom: 8px;
    }

    .edit-category-subtitle {
        color: #728096;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .edit-category-card {
        background: #ffffff;
        border: 1px solid #e5ebf4;
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 8px 30px rgba(20, 48, 90, 0.05);
    }

    .edit-category-section-title {
        color: #0b2453;
        font-size: 17px;
        font-weight: 800;
        padding-bottom: 15px;
        border-bottom: 1px solid #e9eef6;
        margin-bottom: 25px;
    }

    .edit-category-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .edit-category-group {
        margin-bottom: 22px;
    }

    .edit-category-full {
        grid-column: 1 / -1;
    }

    .edit-category-label {
        display: block;
        color: #203b64;
        font-size: 13px;
        font-weight: 750;
        margin-bottom: 9px;
    }

    .edit-category-input {
        width: 100%;
        border: 1px solid #dce5f0;
        background: #fbfcff;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 14px;
        color: #102447;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .edit-category-input:focus {
        outline: none;
        border-color: #1684df;
        box-shadow: 0 0 0 3px rgba(22, 132, 223, 0.12);
        background: #ffffff;
    }

    .edit-category-input::placeholder {
        color: #9aa7b8;
    }

    .edit-category-help {
        display: block;
        color: #8a98ac;
        font-size: 12px;
        margin-top: 7px;
    }

    .edit-category-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #e9eef6;
        padding-top: 25px;
        margin-top: 12px;
    }

    .edit-category-save-btn {
        border: none;
        background: linear-gradient(110deg, #092b76, #0589ef);
        color: #ffffff;
        padding: 13px 25px;
        border-radius: 10px;
        font-weight: 750;
        font-size: 14px;
        cursor: pointer;
    }

    .edit-category-save-btn:hover {
        background: #064caa;
    }

    .edit-category-cancel-btn {
        display: inline-block;
        padding: 12px 23px;
        background: #f3f6fb;
        color: #52647e;
        border: 1px solid #e1e7f0;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
    }

    .edit-category-cancel-btn:hover {
        background: #e9eef6;
        color: #102447;
    }

    @@media (max-width: 700px) {
        .edit-category-page {
            margin-top: 25px;
            padding: 0 15px 40px;
        }

        .edit-category-title {
            font-size: 28px;
        }

        .edit-category-card {
            padding: 22px;
        }

        .edit-category-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .edit-category-full {
            grid-column: auto;
        }

        .edit-category-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .edit-category-save-btn,
        .edit-category-cancel-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="edit-category-page">

    <div class="edit-category-eyebrow">
        ORGANIZER / CATEGORIES
    </div>

    <h1 class="edit-category-title">
        Edit Category
    </h1>

    <p class="edit-category-subtitle">
        Update your race category information.
    </p>

    <div class="edit-category-card">

        <h2 class="edit-category-section-title">
            Category Details
        </h2>

        <form asp-controller="Organiser"
              asp-action="EditCategory"
              asp-route-id="@Model.CategoriesID"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="CategoriesID" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="edit-category-grid">

                <div class="edit-category-group edit-category-full">

                    <label asp-for="EventsID"
                           class="edit-category-label">
                        Select Event *
                    </label>

                    <select asp-for="EventsID"
                            class="edit-category-input"
                            required>

                        <option value="">
                            Select an event
                        </option>

                        @foreach (var eventItem in Model.Events)
                        {
                            <option value="@eventItem.EventsID">
                                @eventItem.EventName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="EventsID"
                          class="text-danger"></span>

                    <small class="edit-category-help">
                        Select the race event this category belongs to.
                    </small>

                </div>

                <div class="edit-category-group edit-category-full">

                    <label asp-for="CategoryName"
                           class="edit-category-label">
                        Category Name *
                    </label>

                    <input asp-for="CategoryName"
                           class="edit-category-input"
                           placeholder="e.g. 10km Fun Run"
                           required />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>

                </div>

                <div class="edit-category-group">

                    <label asp-for="EntryFee"
                           class="edit-category-label">
                        Entry Fee (R) *
                    </label>

                    <input asp-for="EntryFee"
                           type="number"
                           step="0.01"
                           min="0"
                           class="edit-category-input"
                           required />

                    <span asp-validation-for="EntryFee"
                          class="text-danger"></span>

                    <small class="edit-category-help">
                        Enter 0 for a free category.
                    </small>

                </div>

                <div class="edit-category-group">

                    <label asp-for="MaxParticipants"
                           class="edit-category-label">
                        Maximum Participants *
                    </label>

                    <input asp-for="MaxParticipants"
                           type="number"
                           min="1"
                           class="edit-category-input"
                           required />

                    <span asp-validation-for="MaxParticipants"
                          class="text-danger"></span>

                    <small class="edit-category-help">
                        Maximum number of participants allowed.
                    </small>

                </div>

            </div>

            <div class="edit-category-actions">

                <a asp-controller="Organiser"
                   asp-action="ManageCategories"
                   class="edit-category-cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="edit-category-save-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
