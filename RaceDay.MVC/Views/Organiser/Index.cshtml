
@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
    Layout = null;

    int totalEvents = Model?.Count ?? 0;
    int upcomingEvents = Model?.Count(e =>
        e.EventDate.Date >= DateTime.Today) ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>RaceDay | Manage Events</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(180deg, #eaf4ff, #f8fbff);
            color: #09275e;
            font-family: Arial, sans-serif;
        }

        .navbar {
            background: rgba(255,255,255,.96);
            border-bottom: 1px solid #dce6f1;
            padding: 10px 0;
        }

        .nav-inner {
            max-width: 1260px;
            margin: auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
            color: #072d78;
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            font-size: 22px;
        }

        .brand-icon {
            background: linear-gradient(135deg, #063b99, #009bff);
            color: white;
            width: 37px;
            height: 37px;
            border-radius: 10px;
            display: grid;
            place-items: center;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 5px;
            flex: 1;
        }

        .nav-link {
            padding: 11px 13px;
            border-radius: 10px;
            text-decoration: none;
            color: #53647e;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .nav-link:hover,
        .nav-link.active {
            color: #0067e8;
            background: #dceeff;
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .role-badge {
            background: #dceeff;
            color: #0068e8;
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: bold;
        }

        .profile-link {
            border: 1px solid #d5e1ee;
            background: white;
            border-radius: 50%;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            color: #09275e;
            text-decoration: none;
        }

        .page-container {
            max-width: 1260px;
            margin: 0 auto;
            padding: 42px 24px 70px;
        }

        .eyebrow {
            color: #0066ed;
            letter-spacing: 2px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 32px;
        }

        h1 {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            font-size: 44px;
            text-transform: uppercase;
            color: #082c79;
            margin: 0 0 8px;
        }

        .subtitle {
            color: #637797;
            font-size: 15px;
            margin: 0;
        }

        .primary-button {
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            background: linear-gradient(100deg, #082e83, #079af5);
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            display: inline-block;
        }

        .primary-button:hover {
            opacity: .9;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: white;
            border: 1px solid #d7e4f1;
            border-radius: 16px;
            padding: 22px 20px;
            box-shadow: 0 3px 7px rgba(10,50,100,.05);
        }

        .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #536988;
            font-size: 13px;
        }

        .stat-icon {
            color: #0067e8;
            font-size: 21px;
        }

        .stat-number {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-size: 32px;
            color: #082c79;
            margin-top: 12px;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0,1fr));
            gap: 18px;
        }

        .event-card {
            background: white;
            border: 1px solid #d7e4f1;
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 3px 7px rgba(10,50,100,.05);
        }

        .event-title {
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 12px;
        }

        .event-description {
            color: #637797;
            font-size: 13px;
            line-height: 1.6;
            min-height: 42px;
        }

        .event-info {
            color: #536988;
            font-size: 13px;
            margin-top: 12px;
        }

        .event-status {
            display: inline-block;
            margin-top: 15px;
            background: #dceeff;
            color: #0067e8;
            border-radius: 20px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .event-actions {
            margin-top: 20px;
        }

        .secondary-button {
            display: inline-block;
            padding: 10px 14px;
            border-radius: 9px;
            background: #edf5ff;
            color: #0067e8;
            font-size: 12px;
            font-weight: bold;
            text-decoration: none;
        }

        .empty-state {
            border: 1px dashed #cbdff5;
            border-radius: 18px;
            background: rgba(240,247,255,.65);
            padding: 58px 24px;
            text-align: center;
        }

        .empty-icon {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #dceeff;
            color: #0067e8;
            display: grid;
            place-items: center;
            margin: 0 auto 18px;
            font-size: 26px;
        }

        .empty-title {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-size: 23px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .empty-description {
            color: #637797;
            font-size: 13px;
            margin-bottom: 22px;
        }

        .alert {
            background: #fff0f0;
            color: #b42318;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 20px;
        }

        @@media (max-width: 900px) {
            .nav-inner {
                flex-wrap: wrap;
            }

            .nav-links {
                order: 3;
                width: 100%;
                overflow-x: auto;
            }

            .stats-grid,
            .events-grid {
                grid-template-columns: 1fr;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .page-container {
                padding: 28px 16px;
            }

            h1 {
                font-size: 36px;
            }
            .logout-button {
    background: #ffffff;
    color: #09275e;
    border: 1px solid #d5e1ee;
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 12px;
    font-weight: bold;
    cursor: pointer;
    white-space: nowrap;
}

.logout-button:hover {
    background: #dceeff;
    color: #0067e8;
}
        }
    </style>
</head>

<body>

    <header class="navbar">
        <div class="nav-inner">

            <a asp-controller="Organiser"
               asp-action="Index"
               class="brand">
                <span class="brand-icon">⚑</span>
                RACE<span style="color:#008fff">DAY</span>
            </a>

            <nav class="nav-links">

                <a asp-action="Index" class="nav-link active">
                    Events
                </a>

                <a asp-action="ManageCategories" class="nav-link">
                    Categories
                </a>

                <a asp-action="ManageVenues" class="nav-link">
                    Venues
                </a>

                <a asp-action="ManageResults" class="nav-link">
                    Results
                </a>

                <a asp-action="ManageEnrollments" class="nav-link">
                    Enrollments
                </a>

                <a asp-action="MyProfile" class="nav-link">
                    My Profile
                </a>

            </nav>

           <div class="nav-right">

    <span class="role-badge">
        ORGANIZER
    </span>

    <a asp-action="MyProfile"
       class="profile-link"
       title="My Profile">
        ♙
    </a>

    <form asp-controller="Account"
          asp-action="Logout"
          method="post"
          style="margin:0;">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="logout-button">
            Logout
        </button>

    </form>

</div>

        </div>
    </header>

    <main class="page-container">

        <div class="page-header">

            <div>
                <div class="eyebrow">ORGANIZER</div>

                <h1>Manage Events</h1>

                <p class="subtitle">
                    Create, edit and manage your race events.
                </p>
            </div>

            <a asp-action="CreateEvent"
               class="primary-button">
                ⚑ New event
            </a>

        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-top">
                    <span>Events</span>
                    <span class="stat-icon">⚑</span>
                </div>

                <div class="stat-number">
                    @totalEvents
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Upcoming</span>
                    <span class="stat-icon">▦</span>
                </div>

                <div class="stat-number">
                    @upcomingEvents
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-top">
                    <span>Total enrolled</span>
                    <span class="stat-icon">♙</span>
                </div>

              <div class="stat-number">
    @(ViewBag.TotalEnrolled != null
        ? ViewBag.TotalEnrolled.ToString()
        : "—")
</div>
            </div>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="events-grid">

                @foreach (var raceEvent in Model)
                {
                    <div class="event-card">

                        <div class="event-title">
                            @raceEvent.EventName
                        </div>

                        <div class="event-description">
                            @(string.IsNullOrWhiteSpace(raceEvent.Description)
                                ? "No description available."
                                : raceEvent.Description)
                        </div>

                        <div class="event-info">
                            📅 @raceEvent.EventDate.ToString("dd MMM yyyy")
                        </div>

                        <div class="event-info">
                            🕒 @raceEvent.StartTime.ToString(@"hh\:mm")
                        </div>

                        <div class="event-status">
                            @raceEvent.Status
                        </div>

                        <div class="event-actions">
                            <a asp-action="ManageEvents"
                               class="secondary-button">
                                Manage event
                            </a>
                        </div>

                    </div>
                }

            </div>
        }
        else if (ViewBag.ErrorMessage == null)
        {
            <div class="empty-state">

                <div class="empty-icon">⚑</div>

                <div class="empty-title">
                    No Events Yet
                </div>

                <div class="empty-description">
                    Create your first race so participants can start enrolling.
                </div>

                <a asp-action="CreateEvent"
                   class="primary-button">
                    ⚑ Create event
                </a>

            </div>
        }

    </main>

</body>
</html>
