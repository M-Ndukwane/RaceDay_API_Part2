@model RaceDay.MVC.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<style>
        .page-container {
            max-width: 1260px;
            margin: 0 auto;
            padding: 42px 24px 70px;
        }

        .eyebrow {
            color: #0066ed;
            letter-spacing: 2px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .page-container h1 {
            font-family: Impact, "Arial Narrow", sans-serif;
            font-style: italic;
            font-size: 44px;
            text-transform: uppercase;
            color: #082c79;
            margin: 0 0 8px;
        }

        .subtitle {
            color: #637797;
            font-size: 15px;
            margin: 0 0 32px;
        }

        .profile-tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .profile-tab {
            padding: 10px 15px;
            border-radius: 10px;
            color: #536988;
            text-decoration: none;
            font-size: 13px;
        }

        .profile-tab.active {
            background: white;
            color: #09275e;
            box-shadow: 0 2px 6px rgba(0,0,0,.08);
        }

        .profile-card {
            background: white;
            border: 1px solid #d7e4f1;
            border-radius: 20px;
            padding: 32px;
            max-width: 770px;
            box-shadow: 0 5px 15px rgba(10,50,100,.05);
        }

        .photo-section {
            display: flex;
            align-items: center;
            gap: 20px;
            padding-bottom: 24px;
            margin-bottom: 26px;
            border-bottom: 1px solid #e4edf7;
        }

        .avatar {
            width: 78px;
            height: 78px;
            border-radius: 50%;
            background: #dceeff;
            display: grid;
            place-items: center;
            font-size: 32px;
            color: #0067e8;
            flex-shrink: 0;
        }


.avatar {
    overflow: hidden;
}

.avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
}

.avatar-placeholder {
    font-size: 32px;
    color: #0067e8;
}

.photo-details {
    flex: 1;
    min-width: 0;
}

.photo-buttons form {
    margin: 0;
}

.photo-button {
    cursor: pointer;
}

.photo-button:hover {
    opacity: .9;
}


        .photo-title {
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .photo-note {
            color: #71809b;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .photo-buttons {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
        }

        .photo-button {
            border: none;
            background: linear-gradient(100deg, #082e83, #079af5);
            color: white;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 12px;
            font-weight: bold;
        }

        .photo-button:disabled {
            opacity: .65;
            cursor: not-allowed;
        }

        .photo-remove {
            background: #f1f6fc;
            border: 1px solid #d5e1ee;
            color: #536988;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0,1fr));
            gap: 22px 20px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 7px;
        }

        .form-control {
            width: 100%;
            height: 39px;
            border: 1px solid #cbdced;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 13px;
            color: #09275e;
            box-shadow: 0 2px 3px rgba(0,0,0,.05);
        }

        .form-control:focus {
            outline: 2px solid #8bc5ff;
        }

        .form-control:read-only {
            background: #f9fbfe;
            color: #8391a6;
        }

        .field-note {
            color: #71809b;
            font-size: 11px;
            margin-top: 7px;
        }

        .validation-error {
            color: #dc3545;
            font-size: 12px;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            margin-top: 30px;
        }

        .primary-button {
            border: none;
            border-radius: 10px;
            padding: 12px 18px;
            background: linear-gradient(100deg, #082e83, #079af5);
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            cursor: pointer;
        }

        .alert {
            max-width: 770px;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: #e5f8ee;
            color: #126e42;
        }

        .alert-danger {
            background: #fff0f0;
            color: #b42318;
        }

        @@media (max-width: 800px) {

            .page-container {
                padding: 28px 16px;
            }

            .profile-card {
                padding: 22px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .page-container h1 {
                font-size: 36px;
            }
        }
    </style>

<main class="page-container">

        <div class="eyebrow">ACCOUNT</div>

        <h1>My Profile</h1>

        <p class="subtitle">
            Update your personal details and password.
        </p>

        <div class="profile-tabs">

            <a asp-action="MyProfile"
               class="profile-tab active">
                ♙ Personal information
            </a>

            <a asp-action="ChangePassword"
               class="profile-tab">
                ⚿ Change password
            </a>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="profile-card">


<div class="photo-section">

    <div class="avatar">
        <img src="@Url.Action("ProfilePhoto", "Organiser")"
             alt="Profile picture"
             class="avatar-image"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />

        <span class="avatar-placeholder" style="display:none;">♙</span>
    </div>

    <div class="photo-details">
        <div class="photo-title">
            Profile picture
        </div>

        <div class="photo-note">
            JPG, PNG or WEBP. Maximum 5 MB.
        </div>

        <form asp-controller="Organiser"
              asp-action="UploadProfilePhoto"
              method="post"
              enctype="multipart/form-data"
              id="uploadPhotoForm">

            @Html.AntiForgeryToken()

            <input type="file"
                   name="image"
                   id="profileImageInput"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   style="display:none;"
                   onchange="document.getElementById('uploadPhotoForm').requestSubmit();" />

        </form>

        <div class="photo-buttons">

            <button type="button"
                    class="photo-button"
                    onclick="document.getElementById('profileImageInput').click();">
                Upload photo
            </button>

            <form asp-controller="Organiser"
                  asp-action="RemoveProfilePhoto"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to remove your profile picture?');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="photo-button photo-remove">
                    Remove photo
                </button>
            </form>

        </div>
    </div>

</div>


            <form asp-controller="Organiser"
                  asp-action="UpdateProfile"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="UsersID" />

                <div class="form-grid">

                    <div class="form-group">
                        <label asp-for="FirstName">First Name</label>
                        <input asp-for="FirstName"
                               class="form-control" />
                        <span asp-validation-for="FirstName"
                              class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName">Last Name</label>
                        <input asp-for="LastName"
                               class="form-control" />
                        <span asp-validation-for="LastName"
                              class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email"
                               class="form-control"
                               readonly />
                        <div class="field-note">
                            Your sign-in email can't be changed here.
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="PhoneNumber">Phone Number</label>
                        <input asp-for="PhoneNumber"
                               class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Account Created</label>
                        <input value="@Model.CreatedAt.ToString("dd MMM yyyy")"
                               class="form-control"
                               readonly />
                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit" class="primary-button">
                        Save changes
                    </button>
                </div>

            </form>

        </div>

</main>
