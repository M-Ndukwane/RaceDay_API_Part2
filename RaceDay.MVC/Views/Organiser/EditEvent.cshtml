
@model RaceDay.MVC.Models.ManageEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<style>
    .edit-event-page {
        max-width: 980px;
        margin: 45px auto;
        padding: 0 24px 60px;
        color: #102447;
    }

    .edit-eyebrow {
        color: #1265b9;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 8px;
    }

    .edit-title {
        font-size: 34px;
        font-weight: 900;
        font-style: italic;
        text-transform: uppercase;
        color: #0b2453;
        margin-bottom: 8px;
    }

    .edit-subtitle {
        color: #728096;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .edit-card {
        background: #ffffff;
        border: 1px solid #e5ebf4;
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 8px 30px rgba(20, 48, 90, 0.05);
    }

    .edit-section-title {
        font-size: 16px;
        font-weight: 800;
        color: #0b2453;
        margin-bottom: 22px;
        padding-bottom: 14px;
        border-bottom: 1px solid #e9eef6;
    }

    .edit-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .edit-form-group {
        margin-bottom: 22px;
    }

    .edit-form-group.full-width {
        grid-column: 1 / -1;
    }

    .edit-label {
        display: block;
        color: #203b64;
        font-size: 13px;
        font-weight: 750;
        margin-bottom: 9px;
    }

    .edit-input {
        width: 100%;
        border: 1px solid #dce5f0;
        background: #fbfcff;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 14px;
        color: #102447;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .edit-input:focus {
        outline: none;
        border-color: #1684df;
        box-shadow: 0 0 0 3px rgba(22, 132, 223, 0.12);
        background: #ffffff;
    }

    textarea.edit-input {
        min-height: 110px;
        resize: vertical;
    }

    .edit-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #e9eef6;
        padding-top: 25px;
        margin-top: 12px;
    }

    .edit-save-btn {
        border: none;
        background: linear-gradient(110deg, #092b76, #0589ef);
        color: #ffffff;
        padding: 13px 25px;
        border-radius: 10px;
        font-weight: 750;
        font-size: 14px;
        cursor: pointer;
    }

    .edit-save-btn:hover {
        background: #064caa;
    }

    .edit-cancel-btn {
        display: inline-block;
        padding: 12px 23px;
        background: #f3f6fb;
        color: #52647e;
        border: 1px solid #e1e7f0;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
    }

    .edit-cancel-btn:hover {
        background: #e9eef6;
        color: #102447;
    }

    @@media (max-width: 700px) {
        .edit-event-page {
            margin-top: 25px;
            padding: 0 15px 40px;
        }

        .edit-title {
            font-size: 28px;
        }

        .edit-card {
            padding: 22px;
        }

        .edit-form-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .edit-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .edit-save-btn,
        .edit-cancel-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="edit-event-page">

    <div class="edit-eyebrow">ORGANIZER / EVENTS</div>

    <h1 class="edit-title">Edit Event</h1>

    <p class="edit-subtitle">
        Update your race event information.
    </p>

    <div class="edit-card">

        <h2 class="edit-section-title">Race Details</h2>

        <form asp-controller="Organiser"
              asp-action="EditEvent"
              asp-route-id="@Model.EventsID"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="EventsID" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <div class="edit-form-grid">

                <div class="edit-form-group full-width">
                    <label asp-for="EventName" class="edit-label">
                        Event Title *
                    </label>

                    <input asp-for="EventName"
                           class="edit-input"
                           placeholder="Enter event name"
                           required />

                    <span asp-validation-for="EventName"
                          class="text-danger"></span>
                </div>

                <div class="edit-form-group full-width">
                    <label asp-for="Description" class="edit-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="edit-input"
                              rows="4"
                              placeholder="Describe the race event"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="edit-form-group">
                    <label asp-for="EventDate" class="edit-label">
                        Race Date *
                    </label>

                    <input asp-for="EventDate"
                           type="date"
                           class="edit-input"
                           required />

                    <span asp-validation-for="EventDate"
                          class="text-danger"></span>
                </div>

                <div class="edit-form-group">
                    <label asp-for="StartTime" class="edit-label">
                        Start Time *
                    </label>

                    <input asp-for="StartTime"
                           type="time"
                           class="edit-input"
                           required />

                    <span asp-validation-for="StartTime"
                          class="text-danger"></span>
                </div>

                <div class="edit-form-group">
                    <label asp-for="RegistrationDeadline" class="edit-label">
                        Registration Deadline *
                    </label>

                    <input asp-for="RegistrationDeadline"
                           type="datetime-local"
                           class="edit-input"
                           required />

                    <span asp-validation-for="RegistrationDeadline"
                          class="text-danger"></span>
                </div>

                <div class="edit-form-group">
                    <label asp-for="VenuesID" class="edit-label">
                        Venue *
                    </label>

                    <select asp-for="VenuesID"
                            class="edit-input"
                            required>

                        <option value="">Select a venue</option>

                        @foreach (var venue in Model.Venues)
                        {
                            <option value="@venue.VenuesID">
                                @venue.VenueName - @venue.City
                            </option>
                        }
                    </select>

                    <span asp-validation-for="VenuesID"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="edit-actions">

                <a asp-controller="Organiser"
                   asp-action="ManageEvents"
                   class="edit-cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="edit-save-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
