
@model RaceDay.MVC.Models.VenueViewModel

@{
    ViewData["Title"] = "Delete Venue";
}

<style>
    .delete-venue-page {
        max-width: 850px;
        margin: 45px auto;
        padding: 0 24px 60px;
        color: #102447;
    }

    .delete-venue-eyebrow {
        color: #1265b9;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 8px;
    }

    .delete-venue-title {
        font-size: 34px;
        font-weight: 900;
        font-style: italic;
        text-transform: uppercase;
        color: #0b2453;
        margin-bottom: 8px;
    }

    .delete-venue-subtitle {
        color: #728096;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .delete-venue-card {
        background: #ffffff;
        border: 1px solid #e5ebf4;
        border-radius: 18px;
        padding: 36px;
        box-shadow: 0 8px 30px rgba(20, 48, 90, 0.05);
    }

    .venue-delete-warning {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: #fff4f2;
        border: 1px solid #ffd7d2;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .venue-delete-warning-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #ffe0dc;
        color: #c63838;
        font-size: 22px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .venue-delete-warning-title {
        color: #b42323;
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .venue-delete-warning-text {
        color: #98524b;
        font-size: 14px;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .venue-delete-section-title {
        color: #0b2453;
        font-size: 17px;
        font-weight: 800;
        padding-bottom: 15px;
        border-bottom: 1px solid #e9eef6;
        margin-bottom: 22px;
    }

    .venue-delete-name {
        color: #0b2453;
        font-size: 23px;
        font-weight: 800;
        margin-bottom: 24px;
    }

    .venue-delete-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }

    .venue-detail-full {
        grid-column: 1 / -1;
    }

    .venue-detail-label {
        display: block;
        color: #8290a4;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin-bottom: 7px;
    }

    .venue-detail-value {
        color: #203b64;
        font-size: 15px;
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .venue-delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding-top: 25px;
        margin-top: 30px;
        border-top: 1px solid #e9eef6;
    }

    .venue-delete-confirm-btn {
        border: none;
        background: #d83c3c;
        color: #ffffff;
        padding: 13px 24px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 750;
        cursor: pointer;
    }

    .venue-delete-confirm-btn:hover {
        background: #b92828;
    }

    .venue-delete-cancel-btn {
        display: inline-block;
        background: #f3f6fb;
        color: #52647e;
        border: 1px solid #e1e7f0;
        border-radius: 10px;
        padding: 12px 23px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
    }

    .venue-delete-cancel-btn:hover {
        background: #e9eef6;
        color: #102447;
    }

    @@media (max-width: 700px) {
        .delete-venue-page {
            margin-top: 25px;
            padding: 0 15px 40px;
        }

        .delete-venue-title {
            font-size: 28px;
        }

        .delete-venue-card {
            padding: 22px;
        }

        .venue-delete-details {
            grid-template-columns: 1fr;
        }

        .venue-detail-full {
            grid-column: auto;
        }

        .venue-delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .venue-delete-confirm-btn,
        .venue-delete-cancel-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="delete-venue-page">

    <div class="delete-venue-eyebrow">
        ORGANIZER / VENUES
    </div>

    <h1 class="delete-venue-title">
        Delete Venue
    </h1>

    <p class="delete-venue-subtitle">
        Review the venue details before confirming deletion.
    </p>

    <div class="delete-venue-card">

        <div class="venue-delete-warning">

            <div class="venue-delete-warning-icon">
                !
            </div>

            <div>
                <h3 class="venue-delete-warning-title">
                    Are you sure you want to delete this venue?
                </h3>

                <p class="venue-delete-warning-text">
                    This action cannot be undone.
                    The venue will be permanently removed
                    if it is not being used by an existing race event.
                </p>
            </div>

        </div>

        <h2 class="venue-delete-section-title">
            Venue Details
        </h2>

        <h3 class="venue-delete-name">
            @Model.VenueName
        </h3>

        <div class="venue-delete-details">

            <div class="venue-detail-full">

                <span class="venue-detail-label">
                    Street Address
                </span>

                <div class="venue-detail-value">
                    @Model.AddressLine
                </div>

            </div>

            <div>

                <span class="venue-detail-label">
                    City
                </span>

                <div class="venue-detail-value">
                    @Model.City
                </div>

            </div>

            <div>

                <span class="venue-detail-label">
                    Postal Code
                </span>

                <div class="venue-detail-value">
                    @Model.PostalCode
                </div>

            </div>

            <div class="venue-detail-full">

                <span class="venue-detail-label">
                    Province
                </span>

                <div class="venue-detail-value">
                    @Model.Province
                </div>

            </div>

        </div>

        <form asp-controller="Organiser"
              asp-action="DeleteVenueConfirmed"
              asp-route-id="@Model.VenuesID"
              method="post">

            @Html.AntiForgeryToken()

            <div class="venue-delete-actions">

                <a asp-controller="Organiser"
                   asp-action="ManageVenues"
                   class="venue-delete-cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="venue-delete-confirm-btn">
                    Delete Venue
                </button>

            </div>

        </form>

    </div>

</div>
