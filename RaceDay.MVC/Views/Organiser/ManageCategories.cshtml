
@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";

    var categories = Model ??
        new List<RaceDay.MVC.Models.CategoryViewModel>();
}

<style>
    .manage-events-page {
        max-width: 1230px;
        margin: 45px auto;
        padding: 0 24px 60px;
        color: #102447;
    }

    .manage-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .manage-eyebrow {
        color: #1265b9;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
        margin-bottom: 8px;
    }

    .manage-title {
        color: #0b2453;
        font-size: 34px;
        font-weight: 900;
        font-style: italic;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .manage-subtitle {
        color: #728096;
        font-size: 15px;
        margin-bottom: 0;
    }

    .manage-create-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: linear-gradient(110deg, #092b76, #0589ef);
        color: white;
        border-radius: 10px;
        padding: 13px 23px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 750;
        white-space: nowrap;
    }

    .manage-create-btn:hover {
        background: #064caa;
        color: white;
    }

    .manage-stat-card {
        background: #ffffff;
        border: 1px solid #e5ebf4;
        border-radius: 16px;
        padding: 24px 28px;
        box-shadow: 0 8px 30px rgba(20, 48, 90, 0.04);
        margin-bottom: 28px;
    }

    .manage-stat-label {
        color: #728096;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .manage-stat-value {
        color: #0b2453;
        font-size: 32px;
        font-weight: 900;
        margin-bottom: 0;
    }

    .manage-table-card {
        background: white;
        border: 1px solid #e5ebf4;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(20, 48, 90, 0.04);
    }

    .manage-table-heading {
        padding: 22px 26px;
        border-bottom: 1px solid #e9eef6;
    }

    .manage-table-title {
        color: #0b2453;
        font-size: 17px;
        font-weight: 800;
        margin: 0;
    }

    .manage-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .manage-table thead {
        background: #f7faff;
    }

    .manage-table th {
        padding: 16px 22px;
        color: #64748b;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        border-bottom: 1px solid #e9eef6;
        white-space: nowrap;
    }

    .manage-table td {
        padding: 19px 22px;
        color: #425672;
        font-size: 14px;
        vertical-align: middle;
        border-bottom: 1px solid #eef2f8;
    }

    .manage-table tbody tr:last-child td {
        border-bottom: none;
    }

    .manage-table tbody tr:hover {
        background: #fafcff;
    }

    .manage-event-name {
        color: #0b2453;
        font-weight: 800;
    }

    .manage-category-id {
        color: #728096;
        font-weight: 650;
    }

    .manage-status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: #e7f7ee;
        color: #16824a;
        font-size: 12px;
        font-weight: 750;
    }

    .manage-fee {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 8px;
        background: #e9f3ff;
        color: #1265b9;
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .manage-actions {
        display: flex;
        gap: 9px;
        align-items: center;
    }

    .manage-edit-btn {
        display: inline-block;
        padding: 9px 15px;
        border-radius: 8px;
        background: #e9f3ff;
        color: #1265b9;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .manage-edit-btn:hover {
        background: #d6e9ff;
        color: #0b4c9c;
    }

    .manage-delete-btn {
        display: inline-block;
        padding: 9px 15px;
        border-radius: 8px;
        background: #fff0ef;
        color: #cf3737;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .manage-delete-btn:hover {
        background: #ffdfdc;
        color: #b42323;
    }

    .manage-empty {
        padding: 60px 25px;
        text-align: center;
    }

    .manage-empty-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #edf5ff;
        color: #1265b9;
        font-size: 30px;
        font-weight: 800;
    }

    .manage-empty-title {
        color: #0b2453;
        font-size: 19px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .manage-empty-text {
        color: #8290a4;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .manage-back-btn {
        display: inline-block;
        margin-top: 28px;
        background: #f3f6fb;
        color: #52647e;
        border: 1px solid #e1e7f0;
        border-radius: 10px;
        padding: 12px 22px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
    }

    .manage-back-btn:hover {
        background: #e9eef6;
        color: #102447;
    }

    @@media (max-width: 700px) {
        .manage-events-page {
            margin-top: 25px;
            padding: 0 15px 40px;
        }

        .manage-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .manage-title {
            font-size: 28px;
        }

        .manage-create-btn {
            width: 100%;
        }

        .manage-table th,
        .manage-table td {
            padding: 14px;
        }

        .manage-actions {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="manage-events-page">

    <div class="manage-header">

        <div>
            <div class="manage-eyebrow">
                ORGANIZER
            </div>

            <h1 class="manage-title">
                Manage Categories
            </h1>

            <p class="manage-subtitle">
                Organise race categories, entry fees and participant limits.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateCategory"
           class="manage-create-btn">
            + New Category
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["Success"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mb-4">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["Error"]
        </div>
    }

    <div class="manage-stat-card">

        <p class="manage-stat-label">
            Total Categories
        </p>

        <h2 class="manage-stat-value">
            @categories.Count
        </h2>

    </div>

    <div class="manage-table-card">

        <div class="manage-table-heading">
            <h2 class="manage-table-title">
                Race Categories
            </h2>
        </div>

        @if (categories.Count == 0)
        {
            <div class="manage-empty">

                <div class="manage-empty-icon">
                    +
                </div>

                <h3 class="manage-empty-title">
                    No categories yet
                </h3>

                <p class="manage-empty-text">
                    You haven't created any race categories yet.
                    Create your first category to get started.
                </p>

                <a asp-controller="Organiser"
                   asp-action="CreateCategory"
                   class="manage-create-btn">
                    + Create Category
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="manage-table">

                    <thead>
                        <tr>
                            <th>Category ID</th>
                            <th>Event ID</th>
                            <th>Category Name</th>
                            <th>Entry Fee</th>
                            <th>Max Participants</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var category in categories)
                        {
                            <tr>

                                <td>
                                    <span class="manage-category-id">
                                        #@category.CategoriesID
                                    </span>
                                </td>

                                <td>
                                    <span class="manage-category-id">
                                        #@category.EventsID
                                    </span>
                                </td>

                                <td>
                                    <span class="manage-event-name">
                                        @category.CategoryName
                                    </span>
                                </td>

                                <td>
                                    <span class="manage-fee">
                                        R @category.EntryFee.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    @category.MaxParticipants
                                </td>

                                <td>
                                    <div class="manage-actions">

                                        <a asp-controller="Organiser"
                                           asp-action="EditCategory"
                                           asp-route-id="@category.CategoriesID"
                                           class="manage-edit-btn">
                                            Edit
                                        </a>

                                        <a asp-controller="Organiser"
                                           asp-action="DeleteCategory"
                                           asp-route-id="@category.CategoriesID"
                                           class="manage-delete-btn">
                                            Delete
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <a asp-controller="Organiser"
       asp-action="Index"
       class="manage-back-btn">
        ← Back to Dashboard
    </a>

</div>
