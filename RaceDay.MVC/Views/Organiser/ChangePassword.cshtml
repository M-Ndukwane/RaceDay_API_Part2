
@model RaceDay.MVC.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<style>
    .password-page {
        max-width: 850px;
        margin: 40px auto;
        padding: 0 20px 60px;
        font-family: Arial, sans-serif;
        color: #09275e;
    }

    .password-page h1 {
        font-family: Impact, "Arial Narrow", sans-serif;
        font-style: italic;
        font-size: 44px;
        color: #082c79;
        text-transform: uppercase;
    }

    .password-page .subtitle {
        color: #637797;
        margin-bottom: 28px;
    }

    .password-page .profile-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
    }

    .password-page .profile-tab {
        padding: 12px 16px;
        border-radius: 10px;
        text-decoration: none;
        color: #536988;
    }

    .password-page .profile-tab.active {
        background: white;
        color: #0067e8;
        font-weight: bold;
    }

    .password-page .password-card {
        background: white;
        border: 1px solid #d7e4f1;
        border-radius: 20px;
        padding: 32px;
        max-width: 770px;
    }

    .password-page label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .password-page .form-group {
        margin-bottom: 22px;
    }

    .password-page .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #cbdced;
        border-radius: 10px;
    }

    .password-page .primary-button {
        background: linear-gradient(100deg, #082e83, #079af5);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: bold;
        cursor: pointer;
    }

    .password-page .alert {
        padding: 14px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .password-page .alert-success {
        background: #e5f8ee;
        color: #126e42;
    }

    .password-page .alert-danger {
        background: #fff0f0;
        color: #b42318;
    }

    .password-page .validation-error {
        color: #dc3545;
        font-size: 12px;
    }
</style>

<div class="password-page">

    <h1>Change Password</h1>

    <p class="subtitle">
        Update your password to keep your RaceDay account secure.
    </p>

    <div class="profile-tabs">
        <a asp-controller="Organiser"
           asp-action="MyProfile"
           class="profile-tab">
            Personal information
        </a>

        <a asp-controller="Organiser"
           asp-action="ChangePassword"
           class="profile-tab active">
            Change password
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="password-card">

        <form asp-controller="Organiser"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-error"></div>

            <div class="form-group">
                <label asp-for="CurrentPassword">
                    Current Password
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       class="form-control"
                       autocomplete="current-password" />

                <span asp-validation-for="CurrentPassword"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="NewPassword"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="validation-error"></span>
            </div>

            <button type="submit" class="primary-button">
                Update Password
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
